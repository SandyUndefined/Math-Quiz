<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />


    <application
        android:name="com.sandy.quiz.ui.application"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true">


        <receiver
            android:name="com.sandy.quiz.service.AlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <service
            android:name="com.sandy.quiz.service.NotificationService"
            android:enabled="true"
            android:exported="true">

        </service>

        <receiver
            android:name="com.sandy.quiz.service.RestartService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="RestartService" />
            </intent-filter>
        </receiver>


        <!--        <receiver android:name=".DeviceBootReceiver"-->
        <!--            android:enabled="false">-->
        <!--            <intent-filter>-->
        <!--                <action android:name="android.intent.action.BOOT_COMPLETED"/>-->
        <!--            </intent-filter>-->
        <!--        </receiver>-->


        <!--        <receiver android:name=".receiver.AlarmReceiver">-->
        <!--            <intent-filter>-->
        <!--                <action android:name="android.intent.action.BOOT_COMPLETED" />-->
        <!--            </intent-filter>-->
        <!--        </receiver>-->


        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/app_id" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.sandy.quiz.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        <receiver android:name="com.sandy.quiz.receiver.NotificationReceiver" />

        <activity
            android:name="com.sandy.quiz.ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name="com.sandy.quiz.ui.ActivitySetting"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />

        <activity
            android:name="com.sandy.quiz.ui.LearnTableActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />


        <activity
            android:name="com.sandy.quiz.ui.LearnQuizActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />
        <activity
            android:name="com.sandy.quiz.ui.LevelActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />
        <activity
            android:name="com.sandy.quiz.ui.QuizActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />

        <activity
            android:name="com.sandy.quiz.ui.ScoreActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />


        <activity
            android:name="com.sandy.quiz.ui.ReviewAnswerActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />
        <activity
            android:name="com.sandy.quiz.ui.AllReviewTestActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />

        <activity
            android:name="com.sandy.quiz.ui.ReviewTestActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow" />
        <activity
            android:name="com.sandy.quiz.ui.InputActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name="com.sandy.quiz.ui.TrueFalseActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name="com.sandy.quiz.ui.FindMissingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name="com.sandy.quiz.ui.DualActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name="com.sandy.quiz.ui.DualScoreActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name="com.sandy.quiz.ui.ActivityReminder"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/FullScreenWindow"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <service
            android:name="com.sandy.quiz.utils.MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>